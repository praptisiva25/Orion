# Generate a distinct random value of at least 32 characters for each secret.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-key
GROQ_API_KEY=replace-with-your-groq-api-key

# Set this to a model currently enabled for your Groq account.
GROQ_MODEL=your-groq-model
GROQ_TIMEOUT_SECONDS=30
MAX_CONCURRENT_GENERATIONS=8

# Loaded independently: the classifier repo contains weights but not tokenizer files.
SENTIMENT_TOKENIZER_ID=distilbert-base-uncased
SENTIMENT_MODEL_ID=satishmachine/sentiment-model
