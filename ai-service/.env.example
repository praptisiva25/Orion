# Generate a distinct random value of at least 32 characters for each secret.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-internal-key
GROQ_API_KEY=replace-with-your-groq-api-key

# Set this to a model currently enabled for your Groq account.
GROQ_MODEL=your-groq-model
GROQ_TIMEOUT_SECONDS=30
MAX_CONCURRENT_GENERATIONS=8

# Loaded independently: the classifier repo contains weights but not tokenizer files.
SENTIMENT_TOKENIZER_ID=distilbert-base-uncased
SENTIMENT_MODEL_ID=satishmachine/sentiment-model

# NBA foundation defaults. These settings do not load a model or create an index.
NBA_EMBEDDING_PROVIDER=local_sentence_transformers
NBA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NBA_EMBEDDING_REVISION=main
NBA_EMBEDDING_DIMENSION=384
NBA_EMBEDDING_BATCH_SIZE=32
NBA_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
NBA_VECTOR_STORE=faiss
NBA_FAISS_INDEX_PATH=storage/faiss_index
NBA_CHUNK_SIZE_CHARS=1200
NBA_CHUNK_OVERLAP_CHARS=150
NBA_RETRIEVAL_TOP_K=5
NBA_RETRIEVAL_MINIMUM_SCORE=0.70
NBA_MAXIMUM_DOCUMENT_BYTES=25000000
